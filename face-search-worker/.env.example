# Match these values to the Redis endpoint configured on the face-search-queue
# Vercel project. Use REDIS_TLS=true for a rediss/TLS endpoint.
REDIS_HOST=your-managed-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-redis-password
REDIS_TLS=true

# Local gallery root. Use forward slashes on Windows.
CONVOCATION_PHOTOS_DIR=C:/FaceSearch/Jain 15th Convocation

# Start with CPU mode; switch to 0 only after GPU support is installed.
USE_CPU=1
GPU_INDEX=0
WORKER_CONCURRENCY=1
